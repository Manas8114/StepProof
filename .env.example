# Meta Model API (SAM 3.1 + Muse Spark). Never commit the real .env.
MODEL_API_KEY=
META_BASE_URL=https://api.meta.ai/v1
SAM_MODEL=sam-3.1

# Reasoning model. Defaults to Meta's endpoint. If your account cannot reach it,
# point at any OpenAI-compatible gateway and DISCLOSE this in the README/submission.
VISION_MODEL=muse-spark-1.3
# VISION_BASE_URL=https://openrouter.ai/api/v1   (model id there: meta/muse-spark-1.3)
# VISION_API_KEY=

# live = call APIs (using disk cache if present) | replay = cache only, never call APIs
PROVIDER_MODE=live
STEPPROOF_CACHE=1
STEPPROOF_DATA=data

# offline dataset mode: deterministic synthetic providers (scripts.make_dataset), no API key needed.
# Synthesizes data only — never use its numbers for reported metrics.
# STEPPROOF_PROVIDER=mock
